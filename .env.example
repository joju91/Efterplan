# Efterplan — environment variables for Vercel serverless functions.
#
# Sätt INTE dessa här och klistra in manuellt i tre olika verktyg.
# Skriv nyckeln EN gång i ~/.config/efterplan/secrets.env och kör:
#
#   node scripts/sync-secrets.mjs --init   (första gången, skapar mallen)
#   node scripts/sync-secrets.mjs          (synkar till Vercel + GitHub Actions + .env.local)
#
# Se scripts/sync-secrets.mjs för detaljer. Den här filen är bara en
# referens över vilka nycklar som finns och vad de gör — inga riktiga
# värden ska committas här.

STRIPE_SECRET_KEY=sk_live_xxx_or_sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

SUPABASE_URL=https://vjupkemzpnrahdsljenl.supabase.co
# Nya formatet (rekommenderas): sb_secret_xxx från Settings → API Keys
SUPABASE_SECRET_KEY=sb_secret_xxx
# (legacy fallback om du fortfarande har gamla JWT — koden stöder båda)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# T145 — Arkiv/Dokumentcentral: AI-kategorisering av fotade dokument (api/categorize-document.js).
# Saknas den svarar endpointen 503 och klienten faller tillbaka till manuell kategorisering — ingen spärr.
ANTHROPIC_API_KEY=sk-ant-xxx
